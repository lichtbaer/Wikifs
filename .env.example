# LLM API keys (required for agent / natural language queries)
# Set at least one depending on config.toml [agent] default_model (e.g. openai:gpt-4o or anthropic:claude-3-5-sonnet)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: override data directory (Docker default: /data)
# WIKIFS_DATA_DIR=/data

# Optional: path to config.toml (e.g. when using config.docker.toml in Docker)
# WIKIFS_CONFIG_PATH=/path/to/config.toml
